{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HEIC Converter",
  "version": "0.2.1",
  "identifier": "com.youyun.heic-converter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HEIC Converter",
        "width": 920,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "resources": [
      "resources/heif/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5NzlGNTUyQjg2MEM2MkQKUldRdHhtQzRVdlY1ZVUyeHNzbDZNS2Q0WGhnR0tjS0hKakJGODZ3WkUwQUl2TDBUVmQyQlpSamIK",
      "endpoints": [
        "https://github.com/youyun/heic-converter/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
